# Copy to .env and adjust. Never commit .env.

# PostgreSQL
DB_NAME=auction
DB_USER=auction
DB_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=auction
RABBITMQ_PASSWORD=change-me

# Security: HS256 secret, at least 32 characters (generate one with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo data (dev only): admin@example.com and bot1..bot5@example.com
AUCTION_SEED_ENABLED=true
SEED_ADMIN_PASSWORD=change-me-admin
SEED_BOT_PASSWORD=change-me-bots
